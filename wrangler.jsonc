{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vps-monitor",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "routes": [
    {
      "pattern": "vps.ydiws.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vps-monitor-db",
      "database_id": "c6e16b4a-c8e5-4bef-b699-a5bb60b7d14a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AGENT_DOWNLOAD_BASE": "https://github.com/lyd-0718/pulse-vps/releases/latest/download"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
